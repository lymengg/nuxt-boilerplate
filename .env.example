# Copy this file to .env

# --- BFF (Backend-for-Frontend) Configuration ---
# The Nuxt server (Nitro) acts as a BFF: the browser talks only to same-origin
# /api/* routes, and the BFF proxies to the Spring Boot backend server-to-server.
# The browser never sees the backend URL, access tokens, or refresh tokens.

# Spring Boot backend URL (server-to-server, never exposed to the browser).
NUXT_BACKEND_URL=http://localhost:8080

# HMAC secret for signing the opaque BFF session cookie.
# MUST be a long random string in production (e.g. `openssl rand -hex 32`).
# Must be at least 256-bit (32 bytes) of entropy.
NUXT_SESSION_SECRET=dev-only-secret-change-in-production

# --- Session Storage ---
# By default, sessions are stored in-memory (no external deps, perfect for dev).
# Set REDIS_URL to use Redis for distributed, restart-safe sessions in production.
# Redis stores access/refresh tokens — treat it as a sensitive credential store.
# Production Redis should:
#   - Not be publicly accessible
#   - Use authentication/ACL
#   - Use TLS where appropriate
#   - Be network-restricted
#   - Have appropriate memory configuration
#   - Be monitored for eviction
# REDIS_URL=redis://localhost:6379

# --- Session Timeouts ---
# Idle timeout: session expires after this long without activity (default 30 min).
# NUXT_SESSION_IDLE_TIMEOUT=1800000

# Absolute timeout: session expires after this long regardless of activity (default 8 hours).
# NUXT_SESSION_ABSOLUTE_TIMEOUT=28800000

# --- CSRF / Origin Protection ---
# Comma-separated list of trusted frontend origins for CSRF Origin header validation.
# The BFF automatically includes the server's own origin.
# NUXT_ALLOWED_ORIGINS=https://app.example.com

# --- Backend CORS ---
# The backend's `app.frontend-url` must match the Nuxt server origin (default
# http://localhost:3000). Since the BFF calls the backend server-to-server,
# CORS is only needed if the backend enforces origin checks on server-side
# requests. In practice, the BFF bypasses browser CORS entirely.

# --- Prerequisites ---
# 1. Start Redis (required by the backend for refresh tokens, MFA, rate limiting)
#    docker run -d -p 6379:6379 redis:7
# 2. Run the backend:  cd spring-boilerplate && mvnw.cmd spring-boot:run
# 3. Run the frontend: cd nuxt-boilerplate && npm run dev
