# Copy this file to .env

# --- SPA Configuration ---
# The frontend is a static SPA. It calls the Spring backend directly (no
# proxy) at the API origin below, using httpOnly cookies set by the backend.
# Auth is fully backend-owned — this app never touches tokens.

# API origin (browser-facing). Dev default is the local backend.
NUXT_PUBLIC_API_BASE=http://localhost:8080

# --- Prerequisites ---
# 1. Start Redis (required by the BACKEND for refresh tokens, MFA, rate limiting)
#    docker run -d -p 6379:6379 redis:7
# 2. Run the backend:  cd spring-boilerplate && mvnw.cmd spring-boot:run
#    (dev profile; set app.frontend-url=http://localhost:3000 for CORS)
# 3. Run the frontend: cd nuxt-boilerplate && npm run dev
